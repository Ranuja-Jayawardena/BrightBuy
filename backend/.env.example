# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Configuration
# These values are used when running the backend locally (npm run dev) against the
# Dockerized DB exposed on host port 5433. When the backend runs inside Docker,
# docker-compose.yml overrides DB_HOST/DB_PORT to db:5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=brightbuy

# Least-Privilege Application Runtime Account (Fix 8.11 / V35)
# Set DB_APP_USER and DB_APP_PASSWORD to connect with the non-superuser application role:
# DB_APP_USER=brightbuy_app
# DB_APP_PASSWORD=brightbuy_app_pass

# JWT Authentication
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payment Gateway (Phase 6)
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Email Service (Phase 8)
# Configure a real SMTP account before sending. Port 587 uses STARTTLS; 465 uses TLS.
# Use the SMTP account address or a verified sender alias supported by your provider.
# For customer-facing links in email, FRONTEND_URL must be a public HTTPS URL;
# local or non-HTTPS URLs are omitted from transactional messages.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BrightBuy <no-reply@example.com>"

# Cloud Object Storage (AWS S3)
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=brightbuy-media-storage-695945476492

