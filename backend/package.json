{
  "name": "brightbuy-backend",
  "version": "1.0.0",
  "description": "BrightBuy Express Backend API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint src/",
    "test": "jest --runInBand",
    "test:product": "node --test test/product-validation.test.js",
    "test:s3": "node --test test/s3-infrastructure.test.js",
    "test:staff-protection": "node --test test/super-admin-protection.test.js",
    "test:catalog-timestamp": "node --test test/catalog-timestamp-integration.test.js",
    "test:media-concurrency": "node --test test/s3-media-concurrency.test.js",
    "test:db-accounts": "node --test test/database-account-separation.test.js"
  },
  "jest": {
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "keywords": [
    "brightbuy",
    "ecommerce",
    "express",
    "postgres"
  ],
  "author": "BrightBuy Team",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.1.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.9",
    "supertest": "^7.3.1"
  }
}
